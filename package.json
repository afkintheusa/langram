{
  "name": "langram",
  "productName": "Langram",
  "version": "1.0.0",
  "description": "Langram - a Telegram-style messenger for your local network. No internet needed.",
  "main": "main.js",
  "author": "Langram",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.langram.desktop",
    "productName": "Langram",
    "directories": { "output": "dist" },
    "files": ["main.js", "net.js", "store.js", "preload.js", "renderer/**/*", "build/icon.png", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**/*"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Langram-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "Langram-Portable-${version}.${ext}" }
  }
}
